# 复制成 .env 后按需修改；已存在的系统环境变量优先，这里改不动的以面板为准

# ===== 后台密码 =====
# 默认是 admin888，正式活动前务必改掉：去掉下一行行首的 #，等号右边换成你的密码
# ADMIN_PASSWORD=你的新密码

# ===== 端口 =====
# 默认 3000。宝塔 Node 项目里的「项目端口」、Nginx 反代目标端口必须和它一致，
# 三处任何一个对不上，域名访问就是 502（等号两边有空格也能正常解析）
PORT = 3000

# ===== 全站写请求熔断（每分钟）=====
# 100 人 ×（1 次提交 + 3 票）= 400 次；默认 1500 留了 3 倍余量，只有压测才需要调
# WRITE_PER_MIN=1500

# ===== 会话签名密钥 =====
# 留空则自动生成并保存在 data/.session_secret
# SESSION_SECRET=

# ===== 数据目录 =====
# 默认是项目下的 data/；想放到别处（比如独立数据盘）再打开
# DATA_DIR=/mnt/data/interactive-wall
